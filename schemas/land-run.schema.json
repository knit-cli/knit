{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knit land run",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "planId",
    "bundleId",
    "status",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "0.1",
        "0.2"
      ]
    },
    "kind": {
      "const": "KnitLandRun"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "bundleId": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "enum": [
        "github",
        "gitlab",
        "forgejo",
        "bitbucket"
      ]
    },
    "planPath": {
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "skipped",
        "rolled_back",
        "paused"
      ]
    },
    "lane": {
      "type": "string",
      "minLength": 1
    },
    "laneAbsent": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "deploymentsSkipped": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "changedRepos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "bundleHeads": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "rolledBackAt": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "merge_pr",
              "merge_branch",
              "wait_checks",
              "run",
              "deploy",
              "manual",
              "await_update"
            ]
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "succeeded",
              "failed",
              "skipped",
              "rolled_back"
            ]
          },
          "repoId": {
            "type": [
              "string",
              "null"
            ]
          },
          "targetBranch": {
            "type": "string"
          },
          "publicationUrl": {
            "type": "string"
          },
          "startedAt": {
            "type": "string"
          },
          "finishedAt": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "stdout": {
            "type": [
              "string",
              "null"
            ]
          },
          "stderr": {
            "type": [
              "string",
              "null"
            ]
          },
          "exitCode": {
            "type": [
              "integer",
              "null"
            ]
          },
          "before": {
            "type": "object"
          },
          "reviewBefore": {
            "type": "object"
          },
          "output": {
            "type": "object"
          },
          "capture": {
            "type": "object"
          },
          "recovery": {
            "type": "object"
          },
          "sourceRevisions": {
            "type": "object"
          },
          "attribution": {
            "enum": [
              "performed",
              "already_satisfied",
              "uncertain"
            ]
          },
          "attempts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "quiesced": {
            "type": "boolean"
          },
          "intentAt": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "waiting": {
            "type": "object"
          }
        }
      }
    },
    "planHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan": {
      "type": "object"
    },
    "sourceProject": {
      "type": "object"
    },
    "sourceBundle": {
      "type": "object"
    },
    "recoveryStartedAt": {
      "type": "string"
    },
    "recoveryStatus": {
      "enum": [
        "running",
        "restored",
        "failed",
        "manual"
      ]
    },
    "serviceStatus": {
      "enum": [
        "unchanged",
        "restored",
        "partially_restored",
        "unknown"
      ]
    },
    "sourceStatus": {
      "enum": [
        "unchanged",
        "revert_proposed",
        "reverted",
        "partial"
      ]
    },
    "finalization": {
      "type": "object"
    },
    "resultBundle": {
      "type": "object"
    },
    "finalized": {
      "type": "boolean"
    },
    "error": {
      "type": "string"
    },
    "checksSkipped": {
      "type": "boolean"
    },
    "pause": {
      "type": "object",
      "required": [
        "step",
        "instructions",
        "since"
      ],
      "properties": {
        "step": {
          "type": "string"
        },
        "instructions": {
          "type": "string"
        },
        "since": {
          "type": "string"
        },
        "waitingFor": {
          "type": "string"
        },
        "next": {
          "type": "string"
        }
      }
    },
    "acknowledgements": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "at"
        ],
        "properties": {
          "at": {
            "type": "string"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4096
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "paused"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "pause"
        ],
        "properties": {
          "schemaVersion": {
            "const": "0.2"
          }
        }
      }
    }
  ]
}
