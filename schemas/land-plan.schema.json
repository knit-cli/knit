{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knit land plan",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "provider",
    "bundleId",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "0.1",
        "0.2"
      ]
    },
    "kind": {
      "const": "KnitLandPlan"
    },
    "provider": {
      "enum": [
        "github",
        "gitlab",
        "forgejo",
        "bitbucket"
      ]
    },
    "bundleId": {
      "type": "string"
    },
    "sourceProjectId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "onFailure": {
      "enum": [
        "resume",
        "rollback",
        "stop",
        "recover"
      ],
      "default": "resume"
    },
    "requireChecks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "deploy"
                }
              }
            },
            "then": {
              "required": [
                "repoId"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "merge_branch"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "repoId",
                "targetBranch"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "manual"
                }
              }
            },
            "then": {
              "required": [
                "instructions"
              ],
              "not": {
                "required": [
                  "command"
                ]
              }
            }
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "merge_pr",
              "merge_branch",
              "wait_checks",
              "run",
              "deploy",
              "manual"
            ]
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "repoId": {
            "type": "string"
          },
          "method": {
            "enum": [
              "squash",
              "merge",
              "rebase"
            ],
            "default": "merge"
          },
          "waitForChecks": {
            "type": "boolean"
          },
          "requiredChecksOnly": {
            "type": "boolean"
          },
          "deleteBranch": {
            "type": "boolean"
          },
          "requiredOnly": {
            "type": "boolean"
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "intervalSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "cwd": {
            "type": "string"
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "deploymentMode": {
            "enum": [
              "command",
              "push"
            ]
          },
          "checkout": {
            "type": "object",
            "required": [
              "branch"
            ],
            "properties": {
              "branch": {
                "type": "string",
                "minLength": 1
              },
              "remote": {
                "type": "string"
              },
              "update": {
                "enum": [
                  "fetch",
                  "pull",
                  "none"
                ]
              }
            },
            "additionalProperties": false
          },
          "targetBranch": {
            "type": "string",
            "minLength": 1,
            "description": "Destination branch for a merge_branch step."
          },
          "label": {
            "type": "string"
          },
          "role": {
            "enum": [
              "build",
              "verify",
              "release",
              "capture",
              "custom"
            ]
          },
          "effect": {
            "enum": [
              "read_only",
              "source",
              "deployment",
              "external"
            ]
          },
          "recovery": {
            "$ref": "#/$defs/recovery"
          },
          "locks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceRepos": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "interactive": {
            "type": "boolean",
            "description": "Attach a local terminal; command output is not captured."
          },
          "instructions": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "targetBranch": {
      "type": "string",
      "minLength": 1,
      "description": "Common raw target selected with `knit land --target`."
    },
    "lane": {
      "type": "string",
      "minLength": 1,
      "description": "Named project lane this plan resolves."
    },
    "targetBranches": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "description": "Resolved per-repository projection of the lane."
    },
    "laneAbsent": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Changed repositories the lane declares absent; they wait for the terminal landing."
    },
    "deploymentsSkipped": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "description": "Deployments not run, keyed by id, with the repositories each watches."
    },
    "terminal": {
      "type": "boolean",
      "default": true,
      "description": "Whether landing this plan finishes the bundle."
    },
    "changedRepos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Repositories the bundle had changed when the plan was generated."
    },
    "bundleHeads": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Each tracked repository's head when the plan was generated."
    },
    "bundleFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "projectFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "maxParallel": {
      "type": "integer",
      "minimum": 1,
      "default": 4
    },
    "workflow": {
      "$ref": "#/$defs/workflow"
    },
    "recipeRepos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recipeBases": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requiredExecutorVersion": {
      "enum": [
        "0.2",
        "0.3"
      ]
    },
    "merge": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "commandSpec": {
      "type": "object",
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "recovery": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "manual",
            "command",
            "revert_pr"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "capture": {
          "$ref": "#/$defs/commandSpec"
        },
        "verify": {
          "$ref": "#/$defs/commandSpec"
        },
        "probe": {
          "$ref": "#/$defs/commandSpec"
        },
        "idempotent": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "manual"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "command"
              }
            }
          },
          "then": {
            "required": [
              "command",
              "capture",
              "verify",
              "idempotent"
            ],
            "properties": {
              "idempotent": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "workflow": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "step"
          ],
          "properties": {
            "step": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "sequence"
          ],
          "properties": {
            "sequence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/workflow"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "parallel"
          ],
          "properties": {
            "parallel": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/workflow"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "0.2"
          }
        }
      },
      "then": {
        "required": [
          "bundleFingerprint",
          "projectFingerprint"
        ],
        "properties": {
          "onFailure": {
            "enum": [
              "stop",
              "recover"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "onFailure": {
            "enum": [
              "resume",
              "rollback"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "0.2"
          },
          "steps": {
            "contains": {
              "anyOf": [
                {
                  "required": [
                    "interactive"
                  ],
                  "properties": {
                    "interactive": {
                      "const": true
                    }
                  }
                },
                {
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "const": "manual"
                    }
                  }
                }
              ]
            }
          }
        },
        "required": [
          "schemaVersion",
          "steps"
        ]
      },
      "then": {
        "required": [
          "requiredExecutorVersion"
        ],
        "properties": {
          "requiredExecutorVersion": {
            "const": "0.3"
          }
        }
      }
    }
  ]
}
