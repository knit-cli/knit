{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knit land plan",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "provider",
    "bundleId",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "kind": {
      "const": "KnitLandPlan"
    },
    "provider": {
      "enum": [
        "github",
        "gitlab",
        "forgejo",
        "bitbucket"
      ]
    },
    "bundleId": {
      "type": "string"
    },
    "sourceProjectId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "onFailure": {
      "enum": [
        "resume",
        "rollback"
      ],
      "default": "resume"
    },
    "requireChecks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "deploy"
                }
              }
            },
            "then": {
              "required": [
                "repoId"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "merge_branch"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "repoId",
                "targetBranch"
              ]
            }
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "merge_pr",
              "merge_branch",
              "wait_checks",
              "run",
              "deploy"
            ]
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "repoId": {
            "type": "string"
          },
          "method": {
            "enum": [
              "squash",
              "merge",
              "rebase"
            ],
            "default": "merge"
          },
          "waitForChecks": {
            "type": "boolean"
          },
          "requiredChecksOnly": {
            "type": "boolean"
          },
          "deleteBranch": {
            "type": "boolean"
          },
          "requiredOnly": {
            "type": "boolean"
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "intervalSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "cwd": {
            "type": "string"
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "deploymentMode": {
            "enum": [
              "command",
              "push"
            ]
          },
          "checkout": {
            "type": "object",
            "required": [
              "branch"
            ],
            "properties": {
              "branch": {
                "type": "string",
                "minLength": 1
              },
              "remote": {
                "type": "string"
              },
              "update": {
                "enum": [
                  "fetch",
                  "pull",
                  "none"
                ]
              }
            },
            "additionalProperties": false
          },
          "targetBranch": {
            "type": "string",
            "minLength": 1,
            "description": "Destination branch for a merge_branch step."
          }
        },
        "additionalProperties": false
      }
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "targetBranch": {
      "type": "string",
      "minLength": 1,
      "description": "Common raw target selected with `knit land --target`."
    },
    "lane": {
      "type": "string",
      "minLength": 1,
      "description": "Named project lane this plan resolves."
    },
    "targetBranches": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "description": "Resolved per-repository projection of the lane."
    },
    "laneAbsent": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Changed repositories the lane declares absent; they wait for the terminal landing."
    },
    "deploymentsSkipped": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "description": "Deployments not run, keyed by id, with the repositories each watches."
    },
    "terminal": {
      "type": "boolean",
      "default": true,
      "description": "Whether landing this plan finishes the bundle."
    },
    "changedRepos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Repositories the bundle had changed when the plan was generated."
    },
    "bundleHeads": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Each tracked repository's head when the plan was generated."
    }
  },
  "additionalProperties": false
}
