{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knit project",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "createdAt",
    "updatedAt",
    "repos"
  ],
  "properties": {
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "minVersion": {
                "type": "string"
              },
              "optional": {
                "type": "boolean"
              },
              "for": {
                "enum": [
                  "runtime"
                ]
              }
            }
          }
        },
        "diskMib": {
          "type": "integer",
          "minimum": 0
        },
        "memoryMib": {
          "type": "integer",
          "minimum": 0
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "schemaVersion": {
      "const": "0.1"
    },
    "kind": {
      "const": "KnitProject"
    },
    "id": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "repos": {
      "type": "array"
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "groups": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/authGroup"
          }
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "command"
        ],
        "properties": {
          "repos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string"
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "stackRepo": {
          "type": "string"
        },
        "composeFile": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "transform",
            "contract"
          ]
        },
        "profilePath": {
          "type": "string"
        },
        "projectConfigFile": {
          "type": "string"
        },
        "database": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "shared",
                "bundle"
              ]
            },
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "nameTemplate": {
              "type": "string"
            },
            "portBase": {
              "type": "integer"
            },
            "startCommand": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "service": {
              "type": "string",
              "minLength": 1,
              "description": "Compose service that provides the database."
            },
            "containerPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "description": "Port the database listens on inside its container."
            },
            "repos": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Repositories whose stacks attach to this database configuration."
            }
          },
          "additionalProperties": false
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "repo": {
                "type": "string",
                "minLength": 1,
                "description": "Consumer repo id whose stack holds the referencing value."
              },
              "service": {
                "type": "string",
                "minLength": 1,
                "description": "Consumer compose service holding the referencing value."
              },
              "environment": {
                "type": "string",
                "minLength": 1,
                "description": "Environment key on the consumer service that holds the reference. Exactly one of environment/buildArg."
              },
              "buildArg": {
                "type": "string",
                "minLength": 1,
                "description": "Build arg on the consumer service that holds the reference. Exactly one of environment/buildArg."
              },
              "target": {
                "type": "object",
                "properties": {
                  "repo": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Repo id of the endpoint being bound to."
                  },
                  "service": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Compose service of the endpoint being bound to."
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535,
                    "description": "Container-side port disambiguator; mandatory when the target service publishes multiple host ports."
                  }
                },
                "required": [
                  "repo",
                  "service"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "repo",
              "service",
              "target"
            ],
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "environment"
                ],
                "not": {
                  "required": [
                    "buildArg"
                  ]
                }
              },
              {
                "required": [
                  "buildArg"
                ],
                "not": {
                  "required": [
                    "environment"
                  ]
                }
              }
            ]
          },
          "description": "Explicit endpoint bindings: consumer keys pinned to named target endpoints, rewired to the bundle-allocated ports even when duplicate source host ports make automatic wiring ambiguous."
        },
        "startupTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "default": 120,
          "description": "Seconds the runtime waits for stack startup before failing."
        },
        "ports": {
          "type": "object",
          "properties": {
            "backendBase": {
              "type": "integer"
            },
            "frontendBase": {
              "type": "integer"
            },
            "step": {
              "type": "integer"
            },
            "services": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            }
          },
          "additionalProperties": false
        },
        "stacks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Repositories whose compose stacks make up this runtime."
        }
      },
      "additionalProperties": false
    },
    "landing": {
      "type": "object",
      "properties": {
        "provider": {
          "enum": [
            "github",
            "gitlab",
            "forgejo",
            "bitbucket"
          ]
        },
        "onFailure": {
          "enum": [
            "resume",
            "rollback",
            "stop",
            "recover"
          ],
          "default": "resume"
        },
        "requireChecks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "merge": {
          "type": "object",
          "properties": {
            "repoOrder": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "needs": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "includeUnlisted": {
              "type": "boolean"
            },
            "method": {
              "enum": [
                "squash",
                "merge",
                "rebase"
              ],
              "default": "merge"
            },
            "waitForChecks": {
              "type": "boolean"
            },
            "requiredChecksOnly": {
              "type": "boolean"
            },
            "deleteBranch": {
              "type": "boolean"
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "intervalSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "repositories": {
              "type": "object",
              "description": "Per-repository merge policy. Scope overrides inherit individual fields from the root policy. Only changed repositories generate merge operations.",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "mode": {
                    "enum": [
                      "destination",
                      "review"
                    ],
                    "description": "destination follows normal terminal/intermediate behavior; review explicitly merges the recorded review, including at an intermediate destination."
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": true
        },
        "deployments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deployment"
          }
        },
        "targets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "terminal": {
                "type": "boolean"
              },
              "deployments": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/deployment"
                }
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "command": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    },
                    "build": {
                      "$ref": "#/$defs/commandSpec"
                    },
                    "verify": {
                      "$ref": "#/$defs/commandSpec"
                    },
                    "recovery": {
                      "$ref": "#/$defs/recovery"
                    },
                    "type": {
                      "enum": [
                        "run",
                        "deploy",
                        "manual"
                      ]
                    },
                    "interactive": {
                      "type": "boolean"
                    },
                    "instructions": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "type": {
                            "const": "manual"
                          }
                        },
                        "required": [
                          "type"
                        ]
                      },
                      "then": {
                        "required": [
                          "instructions"
                        ],
                        "not": {
                          "required": [
                            "command"
                          ]
                        }
                      },
                      "else": {
                        "required": [
                          "command"
                        ]
                      }
                    }
                  ]
                }
              },
              "merge": {
                "$ref": "#/properties/landing/properties/merge"
              },
              "maxParallel": {
                "type": "integer",
                "minimum": 1
              },
              "onFailure": {
                "enum": [
                  "stop",
                  "recover"
                ]
              },
              "execution": {
                "description": "Opt-in execution policy. Absent inherits the project root (when declared on a lane/target); explicit null disables the root policy for that scope.",
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "const": "repository_sequence"
                      },
                      "repoOrder": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": [
                      "mode",
                      "repoOrder"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "preflight": {
                "description": "Opt-in preflight policies. Absent inherits the project root (when declared on a lane/target); explicit null disables the root policy for that scope.",
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "mergeability": {
                        "const": "all"
                      }
                    },
                    "required": [
                      "mergeability"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "lanes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "defaultBranch": {
                "type": "string",
                "minLength": 1
              },
              "branches": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                }
              },
              "terminal": {
                "type": "boolean"
              },
              "deployments": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/deployment"
                }
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "command": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    },
                    "build": {
                      "$ref": "#/$defs/commandSpec"
                    },
                    "verify": {
                      "$ref": "#/$defs/commandSpec"
                    },
                    "recovery": {
                      "$ref": "#/$defs/recovery"
                    },
                    "type": {
                      "enum": [
                        "run",
                        "deploy",
                        "manual"
                      ]
                    },
                    "interactive": {
                      "type": "boolean"
                    },
                    "instructions": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "type": {
                            "const": "manual"
                          }
                        },
                        "required": [
                          "type"
                        ]
                      },
                      "then": {
                        "required": [
                          "instructions"
                        ],
                        "not": {
                          "required": [
                            "command"
                          ]
                        }
                      },
                      "else": {
                        "required": [
                          "command"
                        ]
                      }
                    }
                  ]
                }
              },
              "merge": {
                "$ref": "#/properties/landing/properties/merge"
              },
              "maxParallel": {
                "type": "integer",
                "minimum": 1
              },
              "onFailure": {
                "enum": [
                  "stop",
                  "recover"
                ]
              },
              "execution": {
                "description": "Opt-in execution policy. Absent inherits the project root (when declared on a lane/target); explicit null disables the root policy for that scope.",
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "const": "repository_sequence"
                      },
                      "repoOrder": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": [
                      "mode",
                      "repoOrder"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "preflight": {
                "description": "Opt-in preflight policies. Absent inherits the project root (when declared on a lane/target); explicit null disables the root policy for that scope.",
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "mergeability": {
                        "const": "all"
                      }
                    },
                    "required": [
                      "mergeability"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "maxParallel": {
          "type": "integer",
          "minimum": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "command": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "build": {
                "$ref": "#/$defs/commandSpec"
              },
              "verify": {
                "$ref": "#/$defs/commandSpec"
              },
              "recovery": {
                "$ref": "#/$defs/recovery"
              },
              "type": {
                "enum": [
                  "run",
                  "deploy",
                  "manual"
                ]
              },
              "interactive": {
                "type": "boolean"
              },
              "instructions": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "manual"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "required": [
                    "instructions"
                  ],
                  "not": {
                    "required": [
                      "command"
                    ]
                  }
                },
                "else": {
                  "required": [
                    "command"
                  ]
                }
              }
            ]
          }
        },
        "execution": {
          "description": "Opt-in execution policy. Absent inherits the project root (when declared on a lane/target); explicit null disables the root policy for that scope.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "const": "repository_sequence"
                },
                "repoOrder": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "mode",
                "repoOrder"
              ],
              "additionalProperties": false
            }
          ]
        },
        "preflight": {
          "description": "Opt-in preflight policies. Absent inherits the project root (when declared on a lane/target); explicit null disables the root policy for that scope.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "mergeability": {
                  "const": "all"
                }
              },
              "required": [
                "mergeability"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "authGroup": {
      "type": "object",
      "description": "One recommended forge credential: repositories it serves and the token kind to create. Descriptive fields are untrusted text; Knit never embeds tokens here.",
      "required": [
        "id",
        "name",
        "provider",
        "host",
        "repos",
        "tokenTypes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$"
        },
        "provider": {
          "enum": [
            "github",
            "gitlab",
            "bitbucket",
            "forgejo"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*$"
        },
        "repos": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tokenTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "permissions": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$"
          }
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "pattern": "^[^\\u0000-\\u0008\\u000B-\\u001F\\u007F-\\u009F]*$",
          "description": "Free text for humans; ordinary newlines and tabs are allowed, other control characters are not."
        },
        "tokenUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^https://",
          "description": "Token creation page. HTTPS only, never carrying userinfo or whitespace; Knit displays it but never opens it.",
          "not": {
            "type": "string",
            "pattern": "[@\\s\\u0000-\\u001F\\u007F-\\u009F]"
          }
        }
      }
    },
    "deployment": {
      "type": "object",
      "required": [
        "id"
      ],
      "anyOf": [
        {
          "required": [
            "repoId"
          ]
        },
        {
          "required": [
            "repo"
          ]
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "repoId": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "command",
            "push"
          ]
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checkout": {
          "type": "object",
          "required": [
            "branch"
          ],
          "properties": {
            "branch": {
              "type": "string",
              "minLength": 1
            },
            "remote": {
              "type": "string"
            },
            "update": {
              "enum": [
                "fetch",
                "pull",
                "none"
              ]
            }
          },
          "additionalProperties": false
        },
        "cwd": {
          "type": "string"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "whenChanged": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Repositories whose changes make this deployment run. Omit to watch the deployment's own repoId. A single \"*\" runs it on every landing and cannot be combined with named repositories."
        },
        "label": {
          "type": "string"
        },
        "build": {
          "$ref": "#/$defs/commandSpec"
        },
        "verify": {
          "$ref": "#/$defs/commandSpec"
        },
        "recovery": {
          "$ref": "#/$defs/recovery"
        },
        "sourceRepos": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "interactive": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "commandSpec": {
      "type": "object",
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
