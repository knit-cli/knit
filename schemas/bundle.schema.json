{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knit bundle",
  "type": "object",
  "required": ["schemaVersion", "kind", "id", "title", "createdAt", "updatedAt", "repos", "commitGroups", "nodes"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "kind": { "const": "ChangeGroup" },
    "id": { "type": "string" },
    "title": { "type": "string" },
    "state": { "enum": ["open", "closed", "archived", "deleted"] },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceRemote": { "type": "string", "minLength": 1 },
          "targetRemote": { "type": "string", "minLength": 1 }
        }
      }
    },
    "commitGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "message": { "type": "string" },
          "createdAt": { "type": "string" },
          "commits": { "type": "array" },
          "author": {
            "type": "object",
            "description": "Git author captured at commit time. Optional for backward compatibility with older artifacts.",
            "properties": {
              "name": { "type": "string" },
              "email": { "type": "string" }
            }
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "allOf": [{
          "if": { "required": ["type"], "properties": { "type": { "const": "feature.landed" } } },
          "then": {
            "if": {
              "required": ["landing"],
              "properties": { "landing": {
                "required": ["mergeMode"],
                "properties": { "mergeMode": { "const": "none" } }
              } }
            },
            "then": { "properties": {
              "repoIds": { "maxItems": 0 },
              "publicationUrls": { "maxItems": 0 },
              "landing": { "properties": { "branchOnly": { "const": false } } }
            } },
            "else": {
              "required": ["repoIds"],
              "properties": { "repoIds": { "minItems": 1 } },
              "if": {
                "required": ["landing"],
                "properties": { "landing": {
                  "required": ["branchOnly"],
                  "properties": { "branchOnly": { "const": true } }
                } }
              },
              "then": { "properties": { "publicationUrls": { "maxItems": 0 } } },
              "else": {
                "required": ["publicationUrls"],
                "properties": { "publicationUrls": { "minItems": 1 } }
              }
            }
          }
        }],
        "properties": {
          "publicationUrls": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "landing": {
            "type": "object",
            "properties": {
              "mergeMode": { "enum": ["none"], "description": "A completed plan without any source merge steps." },
              "branchOnly": { "type": "boolean", "description": "True only when every completed source merge was a branch merge, with no review publications." }
            }
          },
          "rewrite": {
            "type": "object",
            "required": ["kind", "supersededGroups"],
            "properties": {
              "kind": { "enum": ["squash", "rebase", "observed"] },
              "supersededGroups": {
                "type": "array",
                "items": { "$ref": "#/properties/commitGroups/items" }
              }
            }
          },
          "repoChanges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "baseBeforeSha": { "type": "string" },
                "baseAfterSha": { "type": "string" }
              }
            }
          },
          "origin": {
            "type": "object",
            "required": [
              "hostname",
              "platform"
            ],
            "properties": {
              "environmentId": {
                "type": "string"
              },
              "hostname": {
                "type": "string",
                "minLength": 1
              },
              "platform": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "handoff": {
            "type": "object",
            "required": [
              "id",
              "source"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "object",
                "required": [
                  "hostname",
                  "platform"
                ],
                "properties": {
                  "environmentId": {
                    "type": "string"
                  },
                  "hostname": {
                    "type": "string",
                    "minLength": 1
                  },
                  "platform": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "destination": {
                "type": "string"
              },
              "checkpointCommitGroupIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "sizeMib": {
                "type": "integer",
                "minimum": 0
              },
              "outNodeId": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "publications": { "type": "array" }
  }
}
