{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knit project views",
  "type": "object",
  "required": ["schemaVersion", "kind", "projectId", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "kind": { "const": "KnitProjectViews" },
    "projectId": { "type": "string" },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "defaultView": { "type": "string" },
    "views": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/projectView" }
    },
    "templates": {
      "type": "object",
      "description": "Admin-managed shared view templates cached from the sync remote. A read-only cache replaced wholesale by `knit sync pull --views`; never uploaded with the personal document.",
      "additionalProperties": { "$ref": "#/$defs/projectView" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "projectView": {
      "type": "object",
      "properties": {
        "base": {
          "type": "string",
          "enum": ["default", "none"],
          "description": "Seeding mode: `default` seeds from the project's includeByDefault set, `none` seeds empty so include is the complete shape. Omitted when `default`.",
          "default": "default"
        },
        "include": {
          "type": "array",
          "items": { "type": "string" }
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  }
}
